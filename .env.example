# ---------- Backend ----------
LCA_DATA_DIR=./data
LCA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LCA_LOG_LEVEL=INFO

# ---------- LLM providers (all configurable) ----------
# Local orchestration model (Ollama). `ollama pull qwen2.5:7b-instruct`
LCA_LOCAL_LLM_PROVIDER=ollama          # ollama | none
OLLAMA_BASE_URL=http://localhost:11434
LCA_LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# Optional local VLM for hard visual verification: `ollama pull qwen2.5vl:7b`
LCA_LOCAL_VLM_MODEL=qwen2.5vl:7b
# Cloud reasoning model (Groq, GPT-OSS 120B)
GROQ_API_KEY=
LCA_GROQ_MODEL=openai/gpt-oss-120b

# ---------- Vision ----------
# COCO-pretrained detector (auto-downloaded by ultralytics)
LCA_YOLO_OBJECT_WEIGHTS=yolov8s.pt
# Optional custom book-spine weights (fine-tuned elsewhere; we do not train). Empty => classical spine segmentation inside YOLO 'book' boxes.
LCA_YOLO_SPINE_WEIGHTS=
LCA_OCR_ENABLED=true
# Book detector confidence floor. Low on purpose (recall first); OCR + metadata verification filter false boxes.
LCA_BOOK_CONF=0.05

# ---------- Voice ----------
LCA_WHISPER_MODEL=base.en
LCA_TTS_ENGINE=browser                 # browser | kokoro

# ---------- Metadata + pricing ----------
GOOGLE_BOOKS_API_KEY=                  # optional (raises quota)
# Used-book market values (active used listings). eBay Browse API, free developer keys.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Non-book price ranges (Google Shopping via SerpAPI). Optional.
# FREE, instant, no card: https://serper.dev (2,500 searches). Google Shopping -> new AND used book prices + non-book ranges.
SERPER_API_KEY=
# Alternative (100 free/month): https://serpapi.com
SERPAPI_API_KEY=
# FX only used when a price is converted from another currency. Frankfurter needs no key.
LCA_FX_BASE_URL=https://api.frankfurter.app

# ---------- Thresholds ----------
LCA_ID_CONFIDENCE_MIN=0.80
LCA_APPRAISAL_PRICE_THRESHOLD=250      # in claim currency; books above need human appraisal
LCA_MIN_LISTINGS=2                     # listings that must agree before a price is accepted
LCA_HTTP_TIMEOUT_S=10
LCA_HTTP_RETRIES=2

# ---------- Sweep behaviour ----------
# false (default): record during the sweep (~6-7 frames/s), analyse every frame after Stop. true: live inventory during the sweep.
LCA_LIVE_PROCESSING=false
# true (default): ~1 frame/s light preview while recording (on-screen inventory + spoken guidance); false: record only
LCA_LIVE_PREVIEW=true
# analysed frames per sweep (evenly thinned beyond this)
LCA_BATCH_MAX_FRAMES=200
# CLIP check that a detection is really a book (keep true)
LCA_BOOK_GATE=true
# small-model profile for low-power hosts (YOLOv8-nano + PaddleOCR mobile)
LCA_EDGE_PROFILE=false
